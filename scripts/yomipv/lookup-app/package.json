{
  "name": "yomipv-lookup",
  "version": "1.0.3",
  "description": "Yomipv dictionary lookup app",
  "author": "Breno Aqua",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrenoAqua/Yomipv.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -mwl --x64"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.yomipv.lookup",
    "productName": "YomipvLookup",
    "files": [
      "**/*",
      "build/lookup-app.png"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BrenoAqua",
        "repo": "Yomipv"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/lookup-app.png",
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "target": "dir",
      "executableName": "YomipvLookup",
      "icon": "build/lookup-app.png",
      "artifactName": "${productName}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/lookup-app.png",
      "artifactName": "mac-${productName}-${version}.${ext}"
    }
  }
}
